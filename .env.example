# .env.example - NEXUS-X Project Zero
# Copy this file to .env and fill in your keys.

# --- Core API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_CHAT_ID=your_telegram_chat_id_here

# --- Info Services ---
OPENWEATHER_API_KEY=your_weather_key
NEWS_API_KEY=your_news_key
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=gowatch.p.rapidapi.com

# --- System Settings ---
ENVIRONMENT=development
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=gemma3:1b
FLEET_MODE=true
SEARXNG_URL=http://localhost:8888

# --- Storage & Sync (Optional) ---
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
QDRANT_URL=your_qdrant_cloud_url
QDRANT_API_KEY=your_qdrant_api_key
RENDER_URL=https://your-app.onrender.com

# --- Security ---
RELAXED_SECURITY=False
BIOMETRIC_THRESHOLD=0.68
SECURITY_BYPASS=False

# --- Port Settings ---
API_PORT=8000
BRIDGE_PORT=8001

# --- WhatsApp Command Bridge ---
WHATSAPP_ENABLED=true
WHATSAPP_PROGRESS_PUSH=true
ADMIN_NUMBER=91XXXXXXXXXX
# Agent session auto-expire after N seconds of inactivity (default 300 = 5 min)
WHATSAPP_SESSION_TIMEOUT=300
# How often the progress reporter polls for completed tasks (seconds)
WA_PROGRESS_POLL_INTERVAL=5
