{
   "author": "Brett Doyle",
   "background": {
      "persistent": false,
      "scripts": [ "background.js" ]
   },
   "browser_action": {
      "default_icon": {
         "19": "icon19.png",
         "38": "icon38.png"
      },
      "default_popup": "popup.html",
      "default_title": "Downloader"
   },
   "description": "Easily and quickly download multiple files from websites.",
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "19": "icon19.png",
      "38": "icon38.png",
      "48": "icon48.png",
      "80": "icon80.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "Multi-File Downloader",
   "options_ui": {
      "chrome_style": false,
      "page": "options.html"
   },
   "permissions": [ "downloads", "activeTab", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.3"
}
