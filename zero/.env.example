# ═══════════════════════════════════════════════
# PROJECT ZERO — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════

# ── AI Engines ─────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Get free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hf_token_here

# ── Supabase (free at supabase.com) ────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ── n8n Configuration ───────────────────────────
N8N_ENCRYPTION_KEY=generate_random_32_char_string
N8N_HOST=your.oracle.domain.com
POSTGRES_PASSWORD=strong_password_here

# ── Redis ───────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=optional_redis_password

# ── Telegram Bot ────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_CHAT_ID=your_chat_id_number

# ── WhatsApp (optional) ─────────────────────────
WHATSAPP_ENABLED=false
ADMIN_NUMBER=919154716156

# ── Security ────────────────────────────────────
SANDBOX_SECRET=random_secret_for_sandbox_api
JWT_SECRET=random_secret_for_jwt_tokens

# ── System ──────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ── Domain (Oracle Cloud IP or domain) ──────────
DOMAIN=your.oracle.ip.or.domain
