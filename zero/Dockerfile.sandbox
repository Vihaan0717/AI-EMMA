FROM python:3.11-slim

WORKDIR /app

# Minimal dependencies only
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    aiofiles \
    psutil

COPY sandbox/ ./sandbox/

EXPOSE 8001

# Resource-limited execution environment
CMD ["python", "-m", "uvicorn", \
     "sandbox.executor:app", \
     "--host", "0.0.0.0", "--port", "8001"]
